@model IEnumerable<AuditLog>
<h2>Audit Log</h2><form class="row g-2 mb-3"><div class="col-md-4"><input name="action" value="@ViewData["Action"]" class="form-control" placeholder="Action"></div><div class="col-md-4"><input name="module" value="@ViewData["Module"]" class="form-control" placeholder="Module / Entity"></div><div class="col-md-2"><button class="btn btn-outline-primary">Filter</button></div></form><div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>Time</th><th>User</th><th>Action</th><th>Entity</th><th>Record</th><th>Result</th><th>IP</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CreatedDate.ToLocalTime()</td><td>@x.UserId</td><td>@x.Action</td><td>@x.EntityName</td><td>@x.RecordId</td><td>@x.Result</td><td>@x.IpAddress</td></tr>}</tbody></table></div>
