<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="app-header">
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand brand-mark" asp-controller="Dashboard" asp-action="Index">AcxiomCRM</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div id="mainMenu" class="collapse navbar-collapse">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav me-auto gap-lg-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Overview</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Leads" asp-action="Index">Leads</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Opportunities" asp-action="Index">Opportunities</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="FollowUps" asp-action="Index">Follow-ups</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Activities" asp-action="Index">Activities</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a></li>
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Users</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Audit" asp-action="Index">Audit</a></li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <span class="user-chip">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button class="btn btn-sm btn-light">Sign out</button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="ms-auto"><a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Login">Sign in</a></div>
                }
            </div>
        </div>
    </nav>
</header>

<main class="container py-4">
    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-info shadow-sm">@message</div>
    }
    @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
