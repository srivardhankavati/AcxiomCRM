@model DashboardViewModel
<h1 class="mb-4">Dashboard</h1><div class="row g-3">@foreach(var item in new[]{("Customers",Model.TotalCustomers),("Leads",Model.TotalLeads),("Open Leads",Model.OpenLeads),("Opportunities",Model.TotalOpportunities),("Open Opportunities",Model.OpenOpportunities),("Won",Model.WonOpportunities),("Lost",Model.LostOpportunities)}){<div class="col-md-3"><div class="card p-3"><div class="text-muted">@item.Item1</div><div class="kpi">@item.Item2</div></div></div>}<div class="col-md-3"><div class="card p-3"><div class="text-muted">Pipeline Value</div><div class="kpi">@Model.Pipeline.ToString("C")</div></div></div></div><div class="row mt-4 g-4"><div class="col-lg-6"><div class="card p-3"><h5>Lead Status</h5><canvas id="leadChart"></canvas></div></div><div class="col-lg-6"><div class="card p-3"><h5>Opportunity Pipeline</h5><canvas id="oppChart"></canvas></div></div></div>
@section Scripts{<script>const leads=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatus));const opp=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityStage));new Chart(document.getElementById('leadChart'),{type:'doughnut',data:{labels:leads.map(x=>x.Label),datasets:[{data:leads.map(x=>x.Count)}]}});new Chart(document.getElementById('oppChart'),{type:'bar',data:{labels:opp.map(x=>x.Label),datasets:[{label:'Opportunities',data:opp.map(x=>x.Count)}]}});</script>}
