@model ApplicationUser
<h2>Edit User</h2>
<div asp-validation-summary="All" class="text-danger"></div><form method="post" class="card p-4"><div class="mb-3"><label class="form-label">Full Name</label><input name="fullName" value="@Model.FullName" class="form-control"></div><div class="mb-3"><label class="form-label">Email</label><input value="@Model.Email" class="form-control" disabled></div><div class="mb-3"><label class="form-label">Role</label><select name="role" class="form-select">@foreach(var r in ((IEnumerable<string>?)ViewData["Roles"] ?? Array.Empty<string>())){<option selected="@(r==ViewData["CurrentRole"]?.ToString())">@r</option>}</select></div><div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="active" value="true" checked="@(!Model.LockoutEnd.HasValue || Model.LockoutEnd<=DateTimeOffset.UtcNow)"><label class="form-check-label">Active</label></div><button class="btn btn-primary">Save</button></form>
