@model FollowUp
<h2>Schedule Follow-Up</h2>
<div asp-validation-summary="All" class="text-danger"></div><form method="post" class="row g-3"><div class="col-md-4"><label asp-for="FollowUpDate" class="form-label"></label><input asp-for="FollowUpDate" type="date" class="form-control"></div><div class="col-md-4"><label asp-for="FollowUpType" class="form-label"></label><select asp-for="FollowUpType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div><div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Planned</option><option>Cancelled</option></select></div><div class="col-md-6"><label asp-for="CustomerId" class="form-label">Customer</label><select asp-for="CustomerId" class="form-select"><option value="">-- Select --</option>@foreach(var c in ((IEnumerable<Customer>?)ViewData["Customers"] ?? Array.Empty<Customer>())){<option value="@c.CustomerId">@c.CustomerName</option>}</select></div><div class="col-md-6"><label asp-for="LeadId" class="form-label">Lead</label><select asp-for="LeadId" class="form-select"><option value="">-- Select --</option>@foreach(var l in ((IEnumerable<Lead>?)ViewData["Leads"] ?? Array.Empty<Lead>())){<option value="@l.LeadId">@l.LeadName</option>}</select></div><div class="col-12"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control"></textarea></div><div><button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></div></form>
