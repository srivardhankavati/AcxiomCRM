@model IEnumerable<FollowUp>
<div class="d-flex justify-content-between mb-3"><h2>Follow-Ups</h2><a class="btn btn-primary" asp-action="Create">+ Follow-Up</a></div><table class="table table-striped"><thead><tr><th>Date</th><th>Type</th><th>Remarks</th><th>Status</th><th>Assigned</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.FollowUpDate.ToShortDateString()</td><td>@x.FollowUpType</td><td>@x.Remarks</td><td>@x.Status</td><td>@x.AssignedTo</td><td>@if(x.Status=="Planned"){<form asp-action="Complete" method="post" class="d-inline"><input type="hidden" name="id" value="@x.FollowUpId"><button class="btn btn-sm btn-success">Complete</button></form>}</td></tr>}</tbody></table>
