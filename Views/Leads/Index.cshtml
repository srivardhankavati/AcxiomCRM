@model IEnumerable<Lead>
<div class="d-flex justify-content-between mb-3"><h2>Leads</h2><a class="btn btn-primary" asp-action="Create">+ Lead</a></div><form class="input-group mb-3"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search lead, company, status"><button class="btn btn-outline-secondary">Search</button></form><table class="table table-striped"><thead><tr><th>Code</th><th>Name</th><th>Company</th><th>Source</th><th>Status</th><th>Priority</th><th>Expected Value</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.LeadCode</td><td>@x.LeadName</td><td>@x.CompanyName</td><td>@x.Source</td><td>@x.Status</td><td>@x.Priority</td><td>@x.ExpectedValue.ToString("C")</td><td>@if(x.Status=="Qualified"){<a asp-action="Convert" asp-route-id="@x.LeadId" class="btn btn-sm btn-success me-1">Convert</a>}<a asp-action="Edit" asp-route-id="@x.LeadId">Edit</a>@if(User.IsInRole("Admin")||User.IsInRole("Manager")){<text> | <a asp-action="Delete" asp-route-id="@x.LeadId">Delete</a></text>}</td></tr>}</tbody></table>
