@model Activity
<h2>Create Activity</h2>
<div asp-validation-summary="All" class="text-danger"></div><form method="post" class="row g-3"><div class="col-md-4"><label asp-for="ActivityType" class="form-label"></label><select asp-for="ActivityType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div><div class="col-md-8"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control"></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div><div><button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></div></form>
