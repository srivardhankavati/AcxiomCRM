@model AcxiomCrm.Controllers.ReportsViewModel
<h2>Reports</h2><div class="row g-3 mb-4"><div class="col-md-6"><div class="card p-3"><div class="text-muted">Pipeline</div><div class="kpi">@Model.Pipeline.ToString("C")</div></div></div><div class="col-md-6"><div class="card p-3"><div class="text-muted">Weighted Pipeline</div><div class="kpi">@Model.WeightedPipeline.ToString("C")</div></div></div></div>
<div class="card p-3 mb-4"><h4>Opportunity Report</h4><table class="table table-sm"><thead><tr><th>Name</th><th>Stage</th><th>Amount</th><th>Probability</th><th>Close</th></tr></thead><tbody>@foreach(var x in Model.Opportunities){<tr><td>@x.OpportunityName</td><td>@x.Stage</td><td>@x.Amount.ToString("C")</td><td>@x.Probability%</td><td>@x.ExpectedCloseDate.ToShortDateString()</td></tr>}</tbody></table></div>
<div class="card p-3 mb-4"><h4>Lead Report</h4><table class="table table-sm"><thead><tr><th>Lead</th><th>Source</th><th>Status</th><th>Priority</th><th>Expected Value</th></tr></thead><tbody>@foreach(var x in Model.Leads){<tr><td>@x.LeadName</td><td>@x.Source</td><td>@x.Status</td><td>@x.Priority</td><td>@x.ExpectedValue.ToString("C")</td></tr>}</tbody></table></div>
<div class="card p-3"><h4>Follow-Up Report</h4><table class="table table-sm"><thead><tr><th>Date</th><th>Type</th><th>Status</th><th>Remarks</th></tr></thead><tbody>@foreach(var x in Model.FollowUps){<tr><td>@x.FollowUpDate.ToShortDateString()</td><td>@x.FollowUpType</td><td>@x.Status</td><td>@x.Remarks</td></tr>}</tbody></table></div>
