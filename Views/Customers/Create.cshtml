@model Customer

<h2>Create Customer</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form method="post" class="row g-3">

    <div class="col-md-6">
        <label asp-for="CustomerCode" class="form-label"></label>
        <input asp-for="CustomerCode" class="form-control" value="CUST001" />
        <span asp-validation-for="CustomerCode" class="text-danger"></span>
    </div>

    @{ await Html.RenderPartialAsync("_Form", Model); }

    <div>
        <button class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>

</form>