@model Customer
<h2>Customer Details</h2>
<div class="card p-4"><dl class="row"><dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.CustomerCode</dd><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.CustomerName</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.CompanyName</dd><dt class="col-sm-3">Address</dt><dd class="col-sm-9">@Model.Address, @Model.City, @Model.State</dd></dl><a asp-action="Index" class="btn btn-secondary">Back</a></div>
