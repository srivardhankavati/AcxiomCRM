@model IEnumerable<Customer>
<div class="d-flex justify-content-between mb-3"><h2>Customers</h2><a class="btn btn-primary" asp-action="Create">+ Customer</a></div><form class="input-group mb-3"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search name, email, phone, company"><button class="btn btn-outline-secondary">Search</button></form><div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Code</th><th>Name</th><th>Company</th><th>Email</th><th>Phone</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CustomerCode</td><td>@x.CustomerName</td><td>@x.CompanyName</td><td>@x.Email</td><td>@x.Phone</td><td>@x.Status</td><td><a asp-action="Details" asp-route-id="@x.CustomerId">View</a> | <a asp-action="Edit" asp-route-id="@x.CustomerId">Edit</a>@if(User.IsInRole("Admin")||User.IsInRole("Manager")){<text> | <a asp-action="Delete" asp-route-id="@x.CustomerId">Delete</a></text>}</td></tr>}</tbody></table></div>
