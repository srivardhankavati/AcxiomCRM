@model IEnumerable<Opportunity>
<div class="d-flex justify-content-between mb-3"><h2>Opportunities</h2><a class="btn btn-primary" asp-action="Create">+ Opportunity</a></div><form class="input-group mb-3"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search opportunity, stage, status"><button class="btn btn-outline-secondary">Search</button></form><table class="table table-striped"><thead><tr><th>Name</th><th>Stage</th><th>Amount</th><th>Probability</th><th>Weighted</th><th>Close Date</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.OpportunityName</td><td>@x.Stage</td><td>@x.Amount.ToString("C")</td><td>@x.Probability%</td><td>@x.WeightedValue.ToString("C")</td><td>@x.ExpectedCloseDate.ToShortDateString()</td><td>@x.Status</td><td><a asp-action="Edit" asp-route-id="@x.OpportunityId">Edit</a>@if(User.IsInRole("Admin")||User.IsInRole("Manager")){<text> | <a asp-action="Delete" asp-route-id="@x.OpportunityId">Delete</a></text>}</td></tr>}</tbody></table>
