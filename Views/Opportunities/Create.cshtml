@model Opportunity
<h2>Create Opportunity</h2>
<div asp-validation-summary="All" class="text-danger"></div><form method="post" class="row g-3"><input asp-for="OpportunityId" type="hidden"><input asp-for="AssignedTo" type="hidden"><div class="col-md-6"><label asp-for="OpportunityName" class="form-label"></label><input asp-for="OpportunityName" class="form-control"><span asp-validation-for="OpportunityName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="CustomerId" class="form-label">Customer</label><select asp-for="CustomerId" class="form-select"><option value="">-- Select --</option>@foreach(var c in ((IEnumerable<Customer>?)ViewData["Customers"] ?? Array.Empty<Customer>())){<option value="@c.CustomerId">@c.CustomerName</option>}</select></div><div class="col-md-4"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" min="0.01"></div><div class="col-md-4"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" class="form-select"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select></div><div class="col-md-4"><label asp-for="Probability" class="form-label"></label><input asp-for="Probability" class="form-control" min="0" max="100"></div><div class="col-md-4"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" type="date" class="form-control"></div><div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Open</option><option>Won</option><option>Lost</option></select></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control"></textarea></div><div><button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></div></form>
